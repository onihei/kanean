{
  "$ref": "#/definitions/ReceiptMeta",
  "definitions": {
    "ReceiptMeta": {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "type": "number",
          "const": 1
        },
        "id": {
          "type": "string",
          "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$"
        },
        "capturedAt": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
        },
        "image": {
          "type": "object",
          "properties": {
            "fileName": {
              "type": "string",
              "minLength": 1,
              "maxLength": 255
            },
            "contentType": {
              "type": "string",
              "enum": [
                "image/heic",
                "image/heif",
                "image/jpeg",
                "image/png"
              ]
            },
            "sizeBytes": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          },
          "required": [
            "fileName",
            "contentType",
            "sizeBytes",
            "sha256"
          ],
          "additionalProperties": false
        },
        "paymentMethod": {
          "type": "string",
          "enum": [
            "cash",
            "card"
          ]
        },
        "usage": {
          "type": "string",
          "enum": [
            "business",
            "prorated",
            "private"
          ]
        },
        "meal": {
          "type": "object",
          "properties": {
            "partySize": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 999
            },
            "participants": {
              "maxItems": 50,
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 100
              }
            }
          },
          "required": [
            "partySize"
          ],
          "additionalProperties": false
        },
        "memo": {
          "type": "string",
          "maxLength": 1000
        },
        "ocr": {
          "type": "object",
          "properties": {
            "date": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
            },
            "totalAmount": {
              "type": "integer",
              "minimum": 0,
              "exclusiveMaximum": 1000000000000
            }
          },
          "additionalProperties": false
        },
        "qualityFlags": {
          "maxItems": 3,
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "blur",
              "glare",
              "cropped"
            ]
          }
        }
      },
      "required": [
        "schemaVersion",
        "id",
        "capturedAt",
        "image",
        "paymentMethod"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
